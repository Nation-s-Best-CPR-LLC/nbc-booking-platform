# Copy to .env for local development. In staging and production these are
# Replit Secrets, never committed. Secret VALUES never go in this file.

APP_ENV=local                      # local | staging | production (must match app_settings.environment)
DATABASE_URL=postgresql://postgres@localhost:5432/nbc
SECRET_KEY=                        # required outside local: 32+ random characters
PUBLIC_BASE_URL=http://localhost:5000

# Local only: sign in as a seeded demo account without Microsoft 365.
DEV_SIGN_IN=true

# Added by later phases (names only, values in Replit Secrets):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# AIRTABLE_TOKEN=
# GHL_CLIENT_ID=
# GHL_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=             # encrypts GHL OAuth tokens in oauth_connections
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
