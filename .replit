modules = ["python-3.12", "postgresql-16"]
run = "flask --app wsgi run --host 0.0.0.0 --port 5000 --debug"

[deployment]
deploymentTarget = "vm"
run = ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "2", "--access-logfile", "-", "wsgi:app"]
build = ["pip", "install", "-r", "requirements.txt"]

[[ports]]
localPort = 5000
externalPort = 80
